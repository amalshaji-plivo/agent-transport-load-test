# Single-stage build — installs livekit-gateway from PyPI instead of compiling
# the Rust source from a sibling livekit-gateway/ workspace (which isn't present
# on this EC2 box). PyPI 0.1.2 ships manylinux2014_x86_64 cp313 wheels with the
# FFI .so + gateway binary bundled.
#
# Build context still climbs to the parent dir so the COPY of the sibling
# agent-transport-load-test/load_test/ tree continues to work unchanged.

FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Same agent deps as the livekit-python container so the comparison stays
# apples-to-apples. livekit-plugins-turn-detector + EOU pre-download mirror
# the lkp image so neither side pays HF download on the hot path.
RUN pip install --no-cache-dir \
    "livekit-agents>=1.5" \
    livekit-plugins-silero \
    livekit-plugins-turn-detector \
    livekit-gateway==0.1.2 \
    aiohttp loguru websockets uvloop \
    fastapi uvicorn \
    py-spy

RUN python -c "from livekit.plugins.turn_detector.multilingual import _EUORunnerMultilingual; _EUORunnerMultilingual._download_files()"

COPY agent-transport-load-test/load_test/ load_test/

# Plivo-facing (bench client) + AgentServer introspection (worker liveness)
EXPOSE 8084 8181

CMD ["python", "-m", "load_test.servers.livekit_gateway_server", "start"]
